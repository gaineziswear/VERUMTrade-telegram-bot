{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://verum.example/schemas/signal.v1.json",
  "title": "VERUM Signal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "signal_id",
    "asset",
    "direction",
    "status",
    "entry",
    "stop_loss",
    "take_profits",
    "risk",
    "strategy",
    "market_snapshot",
    "created_at",
    "expires_at",
    "disclaimer"
  ],
  "properties": {
    "signal_id": { "type": "string", "minLength": 12 },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol", "chain", "market_type"],
      "properties": {
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "contract_address": { "type": "string" },
        "pair_address": { "type": "string" },
        "chain": { "type": "string" },
        "market_type": { "enum": ["spot", "perpetual", "meme", "new_launch"] },
        "quote_asset": { "type": "string" }
      }
    },
    "direction": { "enum": ["LONG", "SHORT", "WATCH"] },
    "status": {
      "enum": [
        "CANDIDATE", "APPROVED", "PUBLISHED", "ACTIVE",
        "TP_PARTIAL", "BREAKEVEN", "TRAILING",
        "TP_HIT", "SL_HIT", "EXPIRED", "INVALIDATED", "CANCELLED"
      ]
    },
    "entry": {
      "type": "object",
      "required": ["min", "max", "reference"],
      "properties": {
        "min": { "type": "number", "exclusiveMinimum": 0 },
        "max": { "type": "number", "exclusiveMinimum": 0 },
        "reference": { "type": "number", "exclusiveMinimum": 0 },
        "order_type": { "enum": ["market", "limit", "zone"] }
      }
    },
    "stop_loss": {
      "type": "object",
      "required": ["price", "reason"],
      "properties": {
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "reason": { "type": "string" }
      }
    },
    "take_profits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["price", "allocation_pct"],
        "properties": {
          "price": { "type": "number", "exclusiveMinimum": 0 },
          "allocation_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "label": { "type": "string" }
        }
      }
    },
    "risk": {
      "type": "object",
      "required": ["score", "level", "reasons", "round_trip_cost_pct"],
      "properties": {
        "score": { "type": "number", "minimum": 0, "maximum": 100 },
        "level": { "enum": ["LOW", "MODERATE", "HIGH", "EXTREME"] },
        "reasons": { "type": "array", "items": { "type": "string" } },
        "round_trip_cost_pct": { "type": "number", "minimum": 0 },
        "estimated_slippage_pct": { "type": "number", "minimum": 0 },
        "security_checks_passed": { "type": "integer", "minimum": 0 },
        "security_checks_total": { "type": "integer", "minimum": 0 }
      }
    },
    "strategy": {
      "type": "object",
      "required": ["name", "version", "timeframe"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "timeframe": { "type": "string" },
        "thesis": { "type": "string" },
        "invalidation": { "type": "string" },
        "ai_research_summary": { "type": "string" }
      }
    },
    "market_snapshot": {
      "type": "object",
      "required": ["price", "observed_at", "provider"],
      "properties": {
        "price": { "type": "number", "exclusiveMinimum": 0 },
        "volume_24h_usd": { "type": "number", "minimum": 0 },
        "liquidity_usd": { "type": "number", "minimum": 0 },
        "observed_at": { "type": "string", "format": "date-time" },
        "provider": { "type": "string" },
        "chart_url": { "type": "string", "format": "uri" }
      }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "published_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "disclaimer": { "type": "string" }
  }
}
